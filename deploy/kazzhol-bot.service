# systemd unit — keeps the bot running 24/7 and restarts on crash (ТЗ SLA 99.5%).
# Install:
#   sudo cp deploy/kazzhol-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kazzhol-bot
# Logs:  journalctl -u kazzhol-bot -f

[Unit]
Description=Kazzhol AI hotel-manager bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-root user; create with: sudo useradd -r -s /usr/sbin/nologin kazzhol
User=kazzhol
WorkingDirectory=/opt/kazzhol-ai
# .env holds all secrets (chmod 600, owned by kazzhol). NEVER commit it.
EnvironmentFile=/opt/kazzhol-ai/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Node 20+ runs the TS entry via tsx (installed as a dependency).
ExecStart=/usr/bin/node --import tsx /opt/kazzhol-ai/src/index.ts
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kazzhol-ai
PrivateTmp=true

[Install]
WantedBy=multi-user.target
