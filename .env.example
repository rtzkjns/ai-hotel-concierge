# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Core (optional) ----------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5
DB_PATH=./kazzhol.db
PORT=3000
PUBLIC_BASE_URL=

# --- Staff console (recommended) ------------------------------------------------
CONSOLE_ADMIN_LOGIN=admin
CONSOLE_ADMIN_PASSWORD=

# --- Telegram channel -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
STAFF_GROUP_CHAT_ID=

# --- WhatsApp Cloud API -------------------------------------------------------------
# WHATSAPP_PROVIDER=meta   # 'meta' (direct Cloud API, default) or 'd360' (360dialog,
#                          # used for zero-downtime Coexistence — bot stays self-hosted).
#                          # For 'd360' set WHATSAPP_ACCESS_TOKEN to the D360-API-KEY.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Self-onboarding (360dialog-replacement) kit — see docs/REVERSE-360DIALOG.md.
# Our own Meta app id/secret + Embedded Signup config_id, used by scripts/onboard-whatsapp.ts
# and the /admin/onboard/whatsapp page to bypass the BSP once we are an approved Tech Provider.
WHATSAPP_APP_ID=
WHATSAPP_ES_CONFIG_ID=
# GRAPH_VERSION=v23.0
WHATSAPP_PHONE_ID_ALMATY=
WHATSAPP_PHONE_ID_ASTANA=
WHATSAPP_PHONE_ID_PARK_ALMATY=

# --- Instagram (Instagram API with Instagram Login) -------------------------------------
# Instagram User access token (Bearer). Long-lived = 60 days and MUST be refreshed every
# ~30-50 days (ig_refresh_token) or it dies permanently. Obtain via Business Login OAuth;
# scopes: instagram_business_basic + instagram_business_manage_messages.
INSTAGRAM_ACCESS_TOKEN=
# One IG professional account per hotel (recipient.id in the webhook → property).
INSTAGRAM_IG_ID_ALMATY=
INSTAGRAM_IG_ID_ASTANA=
INSTAGRAM_IG_ID_PARK_ALMATY=
INSTAGRAM_IG_ID_SEVEN=      # Kazzhol Seven Almaty (pre-opening; DMs handled, not offered as bookable)
# Per-account access tokens (Instagram Login issues ONE token per account):
INSTAGRAM_TOKEN_ALMATY=
INSTAGRAM_TOKEN_ASTANA=
INSTAGRAM_TOKEN_PARK_ALMATY=
INSTAGRAM_TOKEN_SEVEN=
# Legacy single-account fallback (maps to Almaty when the per-hotel ids above are empty):
# INSTAGRAM_IG_ID=
# API base (host + Graph version). Default: graph.instagram.com/v26.0 (Instagram Login).
# INSTAGRAM_API_BASE=https://graph.instagram.com/v26.0

# --- Exely Connect (live availability / booking) ------------------------------------------
# Each hotel is a SEPARATE Exely cabinet (own client_id/secret/property_id).
# Legacy single-cabinet vars below = Almaty (property 801), kept for back-compat.
EXELY_CLIENT_ID=
EXELY_CLIENT_SECRET=
# EXELY_PROPERTY_ID=801
# EXELY_AUTH_URL=https://connect.hopenapi.com/auth/token
# EXELY_BASE_URL=https://connect.hopenapi.com
EXELY_BOOKING_ENABLED=false
#
# Per-hotel cabinets (fill when each hotel provides its own Exely API connection).
# A hotel with no cabinet here runs on stub availability until its creds arrive.
# EXELY_ASTANA_CLIENT_ID=
# EXELY_ASTANA_CLIENT_SECRET=
# EXELY_ASTANA_PROPERTY_ID=
# EXELY_ASTANA_BOOKING_ENABLED=false
# EXELY_PARK_ALMATY_CLIENT_ID=
# EXELY_PARK_ALMATY_CLIENT_SECRET=
# EXELY_PARK_ALMATY_PROPERTY_ID=
# EXELY_PARK_ALMATY_BOOKING_ENABLED=false

# --- Optional integrations --------------------------------------------------------------------
OPENAI_API_KEY=
AMO_ACCESS_TOKEN=
